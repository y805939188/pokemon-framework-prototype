# ------------------------------------------------------------
# OS / editor noise
# ------------------------------------------------------------
.DS_Store
*.log

# ------------------------------------------------------------
# RPG Maker / RPG Reactor local state
# ------------------------------------------------------------
save/
.rpgreactor.lock
rpgmaker-runtime-backup.zip

# ------------------------------------------------------------
# Modern TypeScript workspace
# ------------------------------------------------------------
src/node_modules/
src/.vite/
src/vendor/rpgreactor/
.reactor-source

# ------------------------------------------------------------
# Hydrated game runtime
#
# These files are installed/generated by RPG Maker or
# RPG Reactor setup. They are not source-of-truth in this repo.
# ------------------------------------------------------------
index.html

js/main.js
js/rmmz_*.js

js/libs/

js/reactor_*.js
js/reactor_plugins.js

# ------------------------------------------------------------
# Generated first-party plugin output
#
# TypeScript under src/plugins/ is the source of truth
# (built by `pnpm --dir src build`; RR_* = template demo, PS_* = this project).
# ------------------------------------------------------------
js/plugins/RR_*.js
js/plugins/RR_*.js.map
js/plugins/PS_*.js
js/plugins/PS_*.js.map

# ------------------------------------------------------------
# Explicit authoring/runtime manifests we DO keep
# ------------------------------------------------------------
!js/plugins.js

# ------------------------------------------------------------
# Pokemon Showdown engine (fetched/built by scripts/build-showdown.sh)
# ------------------------------------------------------------
js/engine/showdown/

# ------------------------------------------------------------
# Local build / test scratch output (regenerated by scripts/)
# ------------------------------------------------------------
/build/
experiments/step2/evidence/package/saves/

# test run saves (package/flow evidence runs)
experiments/step2/evidence/**/saves/

# Engine bundles built from src/framework (pnpm --dir src build:engine)
js/engine/build/
