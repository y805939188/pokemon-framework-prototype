{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruby-ts-differential/runner-response-v1",
  "oneOf": [{"$ref": "#/$defs/success"}, {"$ref": "#/$defs/failure"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "class": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\$?[A-Za-z_][A-Za-z0-9_$]*(?:::[A-Za-z_][A-Za-z0-9_]*)?$"},
    "random": {
      "type": "object", "additionalProperties": false, "required": ["seed", "drawCount", "draws"],
      "properties": {
        "seed": {"type": ["string", "null"], "maxLength": 128, "pattern": "^[A-Za-z0-9._+-]+$"},
        "drawCount": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "draws": {"type": "array", "maxItems": 1000000, "items": {"type": "object", "additionalProperties": false, "required": ["order", "bound", "value"], "properties": {"order": {"type": "integer", "minimum": 0}, "bound": {"type": "integer", "minimum": 1}, "value": {"type": "integer", "minimum": 0}}}}
      }
    },
    "outcome": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "class", "raw"], "properties": {"kind": {"const": "value"}, "class": {"type": "null"}, "raw": true}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "class", "raw"], "properties": {"kind": {"const": "error-object"}, "class": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/class"}]}, "raw": true}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "class", "raw"], "properties": {"kind": {"const": "raised"}, "class": {"$ref": "#/$defs/class"}, "raw": true}}
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["caseId", "requestHash", "outcome"],
      "properties": {"caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"}, "requestHash": {"$ref": "#/$defs/hash"}, "outcome": {"$ref": "#/$defs/outcome"}}
    },
    "success": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "requestHash", "random", "cases"],
      "properties": {"protocol": {"const": "ruby-ts-differential/runner-response-v1"}, "requestHash": {"$ref": "#/$defs/hash"}, "random": {"$ref": "#/$defs/random"}, "cases": {"type": "array", "minItems": 1, "maxItems": 100000, "items": {"$ref": "#/$defs/case"}}}
    },
    "failure": {
      "type": "object", "additionalProperties": false, "required": ["protocol", "requestHash", "error"],
      "properties": {
        "protocol": {"const": "ruby-ts-differential/runner-response-v1"}, "requestHash": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/hash"}]},
        "error": {"type": "object", "additionalProperties": false, "required": ["kind", "code"], "properties": {"kind": {"enum": ["SERIALIZATION_ERROR", "PROTOCOL_ERROR", "RUNNER_ERROR"]}, "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,80}$"}}}
      }
    }
  }
}
