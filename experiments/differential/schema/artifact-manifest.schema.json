{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruby-ts-differential/artifact-manifest-v1",
  "type": "object", "additionalProperties": false,
  "required": ["protocol", "builtAtUTC", "nodeVersion", "viteVersion", "typescriptVersion", "source", "files"],
  "properties": {
    "protocol": {"const": "ruby-ts-differential/artifact-manifest-v1"},
    "builtAtUTC": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"},
    "nodeVersion": {"const": "v22.21.1"}, "viteVersion": {"const": "8.3.1"}, "typescriptVersion": {"const": "7.0.2"},
    "source": {"type": "object", "additionalProperties": false, "required": ["commit", "tree", "dirty"], "properties": {"commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"}, "dirty": {"type": "boolean"}}},
    "files": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "additionalProperties": false, "required": ["path", "bytes", "sha256"], "properties": {"path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]{1,256}$"}, "bytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}}}
  }
}
