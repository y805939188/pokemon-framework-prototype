{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruby-ts-differential/runner-config-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "request", "freezeHash", "privateDirectory", "publicDirectory", "limits", "runners"],
  "properties": {
    "protocol": {"const": "ruby-ts-differential/runner-config-v1"},
    "request": {"type": "string", "minLength": 1, "maxLength": 4096},
    "freezeHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "privateDirectory": {"type": "string", "minLength": 1, "maxLength": 4096},
    "publicDirectory": {"type": "string", "minLength": 1, "maxLength": 4096},
    "limits": {
      "type": "object", "additionalProperties": false, "required": ["timeoutMs", "maxStdoutBytes", "maxStderrBytes"],
      "properties": {"timeoutMs": {"type": "integer", "minimum": 100, "maximum": 300000}, "maxStdoutBytes": {"type": "integer", "minimum": 1024, "maximum": 67108864}, "maxStderrBytes": {"type": "integer", "minimum": 1, "maximum": 1048576}}
    },
    "runners": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/runner"}}
  },
  "$defs": {
    "runner": {
      "type": "object", "additionalProperties": false,
      "required": ["role", "entryId", "argv", "cwd", "publicMetadata"],
      "properties": {
        "role": {"enum": ["reference", "candidate"]},
        "entryId": {"enum": ["reference-rules-v1", "ts-core-v1"]},
        "argv": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "string", "minLength": 1, "maxLength": 4096}},
        "cwd": {"type": "string", "minLength": 1, "maxLength": 4096},
        "publicMetadata": {
          "type": "object", "additionalProperties": false, "required": ["source", "runtime"],
          "properties": {"source": true, "runtime": true}
        }
      }
    }
  }
}
