{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruby-ts-differential/behavior-package-v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "role", "entryId", "requestHash", "freezeHash", "observedAtUTC", "source", "runtime", "execution", "random", "cases"],
  "properties": {
    "protocol": {"const": "ruby-ts-differential/behavior-package-v1"},
    "role": {"enum": ["reference", "candidate"]},
    "entryId": {"enum": ["reference-rules-v1", "ts-core-v1"]},
    "requestHash": {"$ref": "#/$defs/hash"},
    "freezeHash": {"$ref": "#/$defs/hash"},
    "observedAtUTC": {"$ref": "#/$defs/timestamp"},
    "source": {"$ref": "#/$defs/source"},
    "runtime": {"$ref": "#/$defs/runtime"},
    "execution": {"$ref": "#/$defs/execution"},
    "random": {
      "type": "object", "additionalProperties": false, "required": ["seed", "drawCount", "draws"],
      "properties": {"seed": {"type": "null"}, "drawCount": {"const": 0}, "draws": {"type": "array", "maxItems": 0, "items": true}}
    },
    "cases": {"type": "array", "maxItems": 100000, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"},
    "version": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"},
    "class": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^\\$?[A-Za-z_][A-Za-z0-9_$]*(?:::[A-Za-z_][A-Za-z0-9_]*)?$"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["commit", "tree", "tag", "dirty", "files"],
      "properties": {
        "commit": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "tree": {"oneOf": [{"type": "null"}, {"type": "string", "pattern": "^[0-9a-f]{40}$"}]},
        "tag": {"oneOf": [{"type": "null"}, {"const": "v21.1"}]},
        "dirty": {"type": ["boolean", "null"]},
        "files": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["role", "sha256"], "properties": {"role": {"enum": ["growth-rules", "friendship-rules", "runner", "core-bundle", "adapter"]}, "sha256": {"$ref": "#/$defs/hash"}}}}
      }
    },
    "runtime": {
      "type": "object", "additionalProperties": false, "required": ["name", "version", "dependencies"],
      "properties": {
        "name": {"enum": ["node", "reference"]},
        "version": {"$ref": "#/$defs/version"},
        "dependencies": {"type": "array", "maxItems": 16, "items": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"enum": ["node", "vite", "typescript", "reference-runtime", "adapter"]}, "version": {"$ref": "#/$defs/version"}}}}
      }
    },
    "execution": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "startedAtUTC", "endedAtUTC", "durationMs", "exitCode", "signal", "timeoutMs", "maxStdoutBytes", "maxStderrBytes", "stdoutBytes", "stderrBytes", "stdoutSha256", "stderrSha256", "timedOut", "outputLimitExceeded"],
      "properties": {
        "status": {"enum": ["success", "process-error", "timeout", "protocol-error"]},
        "startedAtUTC": {"$ref": "#/$defs/timestamp"}, "endedAtUTC": {"$ref": "#/$defs/timestamp"}, "durationMs": {"type": "integer", "minimum": 0, "maximum": 3600000},
        "exitCode": {"type": ["integer", "null"], "minimum": 0, "maximum": 255},
        "signal": {"enum": [null, "SIGABRT", "SIGFPE", "SIGILL", "SIGINT", "SIGKILL", "SIGSEGV", "SIGTERM"]},
        "timeoutMs": {"type": "integer", "minimum": 100, "maximum": 300000},
        "maxStdoutBytes": {"type": "integer", "minimum": 1024, "maximum": 67108864}, "maxStderrBytes": {"type": "integer", "minimum": 1, "maximum": 1048576},
        "stdoutBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}, "stderrBytes": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "stdoutSha256": {"$ref": "#/$defs/hash"}, "stderrSha256": {"$ref": "#/$defs/hash"},
        "timedOut": {"type": "boolean"}, "outputLimitExceeded": {"type": "boolean"}
      }
    },
    "friendshipPlan": {
      "type": "object", "additionalProperties": false, "required": ["status", "before", "after", "delta"],
      "properties": {"status": {"const": "ready"}, "before": {"type": "integer", "minimum": 0, "maximum": 255}, "after": {"type": "integer", "minimum": 0, "maximum": 255}, "delta": {"type": "integer", "minimum": -255, "maximum": 255}}
    },
    "value": {
      "oneOf": [
        {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        {"type": "object", "additionalProperties": false, "required": ["after", "steps"], "properties": {"after": {"type": "integer"}, "steps": {"type": "array", "maxItems": 8, "items": {"type": "integer"}}}},
        {"$ref": "#/$defs/friendshipPlan"},
        {"type": "object", "additionalProperties": false, "required": ["status", "affection"], "properties": {"status": {"const": "ready"}, "affection": {"type": "integer", "minimum": 0, "maximum": 5}}},
        {"type": "object", "additionalProperties": false, "required": ["steps", "after"], "properties": {"steps": {"type": "array", "minItems": 2, "maxItems": 8, "items": {"$ref": "#/$defs/friendshipPlan"}}, "after": {"type": "integer", "minimum": 0, "maximum": 255}}}
      ]
    },
    "errorValue": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"const": "invalid-level"}}},
        {"type": "object", "additionalProperties": false, "required": ["code", "value"], "properties": {"code": {"const": "friendship-out-of-domain"}, "value": {"type": "number", "minimum": -1000, "maximum": 1000}}},
        {"type": "object", "additionalProperties": false, "required": ["code"], "properties": {"code": {"const": "unknown-friendship-method"}}}
      ]
    },
    "outcome": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["kind", "value"], "properties": {"kind": {"const": "value"}, "value": {"$ref": "#/$defs/value"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "class", "value"], "properties": {"kind": {"const": "error-object"}, "class": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/class"}]}, "value": {"$ref": "#/$defs/errorValue"}}},
        {"type": "object", "additionalProperties": false, "required": ["kind", "class"], "properties": {"kind": {"const": "raised"}, "class": {"$ref": "#/$defs/class"}}}
      ]
    },
    "case": {
      "type": "object", "additionalProperties": false, "required": ["caseId", "requestHash", "outcome"],
      "properties": {"caseId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"}, "requestHash": {"$ref": "#/$defs/hash"}, "outcome": {"$ref": "#/$defs/outcome"}}
    }
  }
}
