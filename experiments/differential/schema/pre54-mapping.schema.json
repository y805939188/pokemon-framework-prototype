{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ruby-ts-differential/mapping-v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "version",
    "errorClassMappings",
    "approvedDifferences",
    "classifications"
  ],
  "properties": {
    "protocol": {
      "const": "ruby-ts-differential/mapping-v1"
    },
    "version": {
      "const": "pre54-batch2-mapping-v1"
    },
    "errorClassMappings": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mappingId",
          "operation",
          "additionalClass",
          "kind",
          "referenceClass",
          "candidateClass"
        ],
        "properties": {
          "mappingId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
          },
          "operation": {
            "enum": [
              "learning.relearningCandidates",
              "learning.forgetting",
              "pokedex.recordSequence",
              "pokedex.recentSequence",
              "stats.computeStats",
              "stats.hpAfterRecalc"
            ]
          },
          "additionalClass": {
            "enum": [
              "wrapper-qualification",
              "approved-keep-fainted-default"
            ]
          },
          "kind": {
            "enum": [
              "value",
              "error-object",
              "raised"
            ]
          },
          "referenceClass": {
            "$ref": "#/$defs/nullableClass"
          },
          "candidateClass": {
            "$ref": "#/$defs/nullableClass"
          }
        }
      }
    },
    "approvedDifferences": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "requestHash",
          "referenceOutcomeHash",
          "candidateOutcomeHash",
          "expiresUTC",
          "review"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9.-]{2,95}$"
          },
          "requestHash": {
            "$ref": "#/$defs/hash"
          },
          "referenceOutcomeHash": {
            "$ref": "#/$defs/hash"
          },
          "candidateOutcomeHash": {
            "$ref": "#/$defs/hash"
          },
          "expiresUTC": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,3})?Z$"
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "decision",
              "reviewHash"
            ],
            "properties": {
              "decision": {
                "const": "INDEPENDENT_APPROVED_DIVERGENCE"
              },
              "reviewHash": {
                "$ref": "#/$defs/hash"
              }
            }
          }
        }
      }
    },
    "classifications": {
      "type": "array",
      "maxItems": 0,
      "items": true
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "nullableClass": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^\\$?[A-Za-z_][A-Za-z0-9_$]*(?:::[A-Za-z_][A-Za-z0-9_]*)?$"
        }
      ]
    }
  }
}
